# Environment Configuration Example
# Copy this file to .env and fill in actual values

# Flask configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:///pds_leak_detection.db
# For PostgreSQL: postgresql://user:password@localhost:5432/pds_leak_detection

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production-12345

# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# Logging
LOG_LEVEL=INFO

# ML Model configuration
# Isolation Forest contamination ratio
ML_CONTAMINATION=0.1

# Data retention (days)
DATA_RETENTION_DAYS=365

# Anomaly thresholds
STOCK_ANOMALY_THRESHOLD=0.7
ATTENDANCE_ANOMALY_THRESHOLD=0.7
DELIVERY_ANOMALY_THRESHOLD=0.7
